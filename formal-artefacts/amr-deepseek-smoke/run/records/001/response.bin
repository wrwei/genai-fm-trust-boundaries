{"schema":"amr-supervisor/v1","select":[{"when":"OwnerFree and RequestA and RequestB","action":"SelectA"},{"when":"OwnerFree and RequestA","action":"SelectA"},{"when":"OwnerFree and RequestB","action":"SelectB"},{"when":"True","action":"Defer"}],"step":[{"when":"not ObservationUsable or not TaskActive or PedestrianBlocked","action":"Brake","next":"BrakeRequested"},{"when":"not ObservationUsable or not TaskActive or PedestrianBlocked","action":"Brake","next":"Stopped"},{"when":"AtGoal and Released and not Halted","action":"Brake","next":"BrakeRequested"},{"when":"AtGoal and Released and Halted","action":"Finish","next":"Done"},{"when":"OwnReservation and BodyClearOfZ","action":"Release","next":"Traversing"},{"when":"ModeBrakeRequested and not Halted","action":"Brake","next":"BrakeRequested"},{"when":"not OwnReservation and not Released","action":"Request","next":"Waiting"},{"when":"ModeStopped","action":"Resume","next":"ResumePending"},{"when":"True","action":"Proceed","next":"Traversing"}]}