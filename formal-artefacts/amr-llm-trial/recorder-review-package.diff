+def _chain_state(records: list[dict], sample: str) -> str:
+    chain = [r for r in records if r["sample_id"] == sample]
+    if not chain:
+        return "unattempted"
+    if any(r["accepted"] for r in chain):
+        return "accepted"
+    if chain[-1]["terminal_reason"] is not None:
+        return chain[-1]["terminal_reason"]
+    if len(chain) >= 3:
+        return "exhausted"
