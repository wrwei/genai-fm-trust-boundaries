{
 "schema": "path-sanitisation/v1",
 "date": "2026-09-25",
 "purpose": "Remove machine-local paths from the public deposit without altering any recorded checksum.",
 "rules": [
  {
   "match": "<LOCAL_CHECKOUT>/<rel>, where <LOCAL_CHECKOUT> is the Windows working checkout, in any of four spellings (forward slash, backslash, JSON-escaped backslash, Cygwin /cygdrive)",
   "replacement": "https://github.com/wrwei/genai-fm-trust-boundaries/{blob|tree}/main/<rel>",
   "note": "blob for files, tree for directories; the bare checkout root becomes the tree URL"
  },
  {
   "match": "<LOCAL_CHECKOUT>/<rel> used as the working directory of a documented shell command (Set-Location, cd, 'Command, from')",
   "replacement": "<rel>, relative to the repository root, so the command stays runnable"
  },
  {
   "match": "the local Isabelle2025-2 installation directory",
   "replacement": "<ISABELLE_HOME>/<rest>"
  },
  {
   "match": "the Isabelle workspace containing that installation",
   "replacement": "<ISABELLE_WORKDIR>/<rest>"
  },
  {
   "match": "other local scratch directories beside the checkout",
   "replacement": "<LOCAL_WORKDIR>/<rest>"
  },
  {
   "match": "hol/build.py in five packages",
   "replacement": "Isabelle install read from the ISABELLE_HOME environment variable; USER_HOME from ISABELLE_USER_HOME, default $HOME"
  }
 ],
 "not_changed": [
  "No checksum anywhere in the deposit was edited. Manifests, frozen-input records, baseline hashes and run records still carry the digests of the original bytes.",
  "Windows interpreter paths under C:/Users/Admin/ (a generic account name) are retained verbatim.",
  "Line endings, byte order and all non-path content are unchanged."
 ],
